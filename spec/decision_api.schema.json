{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ales-invariant.dev/spec/v0.1/decision_api.schema.json",
  "title": "AuthorizeAPI",
  "$defs": {
    "AuthorizeRequest": {
      "type": "object",
      "required": ["tenant_id", "principal", "purpose", "objects"],
      "properties": {
        "tenant_id": {"type": "string"},
        "principal": {
          "type": "object",
          "required": ["type", "id"],
          "properties": {"type": {"enum": ["user", "agent", "service"]}, "id": {"type": "string"}},
          "additionalProperties": false
        },
        "purpose": {"type": "string"},
        "agent_id": {"type": ["string", "null"]},
        "session_id": {"type": ["string", "null"]},
        "objects": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["context_id"],
            "properties": {"context_id": {"type": "string"}, "version": {"type": ["string", "null"]}},
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "AuthorizeResponse": {
      "type": "object",
      "required": ["decision", "reason", "revocation_epoch", "policy_version", "trace_id", "objects"],
      "properties": {
        "decision": {"$ref": "#/$defs/Decision"},
        "reason": {"type": "array", "items": {"$ref": "#/$defs/ReasonCode"}},
        "revocation_epoch": {"type": "integer", "minimum": 0},
        "policy_version": {"type": "string"},
        "trace_id": {"type": "string"},
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["context_id", "decision", "reason"],
            "properties": {
              "context_id": {"type": "string"},
              "version": {"type": ["string", "null"]},
              "decision": {"$ref": "#/$defs/Decision"},
              "reason": {"type": "array", "items": {"$ref": "#/$defs/ReasonCode"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "Decision": {"enum": ["ALLOW", "DENY", "UNKNOWN", "REFRESH", "REDACT", "QUARANTINE", "HUMAN_REVIEW"]},
    "ReasonCode": {"enum": ["ANCESTOR_ACL_REVOKED", "ANCESTOR_DELETED", "ANCESTOR_SUPERSEDED", "ANCESTOR_EXPIRED", "ANCESTOR_QUARANTINED", "PRINCIPAL_NOT_IN_SCOPE", "PURPOSE_NOT_IN_SCOPE", "LINEAGE_INCOMPLETE", "OBJECT_UNKNOWN", "TENANT_MISMATCH", "POLICY_SNAPSHOT_STALE", "OK"]}
  }
}
